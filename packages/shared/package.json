{
    "name": "brutx-shared-vue",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./scan": "./src/scan.ts",
        "./design-tokens": "./src/design-tokens.ts",
        "./tokens": "./src/tokens/index.ts",
        "./fs": "./src/fs/index.ts",
        "./ast": "./src/ast/index.ts",
        "./generation": "./src/generation.ts",
        "./api-contract": "./src/api-contract.ts",
        "./module-resolver": "./src/module-resolver.ts"
    },
    "engines": {
        "node": ">=22.5"
    },
    "scripts": {
        "typecheck": "pnpm exec turbo run typecheck:source --filter=brutx-shared-vue",
        "typecheck:source": "tsc --noEmit",
        "lint:source": "eslint src tests",
        "lint": "pnpm exec turbo run lint:source --filter=brutx-shared-vue",
        "test": "vitest run"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.1",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@vue/compiler-sfc": "^3.5.42",
        "magic-string": "^0.30.21"
    }
}
