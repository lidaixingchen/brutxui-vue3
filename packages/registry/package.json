{
    "name": "brutx-registry-vue",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "build": "pnpm exec turbo run build:artifact --filter=brutx-registry-vue",
        "build:artifact": "tsx scripts/build-registry.ts",
        "build:watch": "tsx scripts/build-registry.ts --watch",
        "build:verify": "tsx scripts/verify-build.ts",
        "bench": "tsx scripts/build-registry.ts --bench",
        "validate": "tsx scripts/validate-registry.ts",
        "lint": "pnpm exec turbo run lint:source --filter=brutx-registry-vue",
        "lint:source": "eslint src scripts tests",
        "test": "vitest run",
        "typecheck": "pnpm exec turbo run typecheck:source --filter=brutx-registry-vue",
        "typecheck:source": "tsc --noEmit"
    },
    "dependencies": {
        "brutx-shared-vue": "workspace:*"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.1",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vitest": "^4.1.11"
    }
}
