{
    "name": "brutx-vue",
    "version": "0.11.2",
    "description": "CLI for adding Neo-Brutalist Vue 3 UI components to your project",
    "bin": {
        "brutx-vue": "dist/index.js"
    },
    "main": "./dist/api.js",
    "module": "./dist/api.js",
    "types": "./dist/api.d.ts",
    "exports": {
        ".": {
            "types": "./dist/api.d.ts",
            "import": "./dist/api.js"
        },
        "./api": {
            "types": "./dist/api.d.ts",
            "import": "./dist/api.js"
        }
    },
    "type": "module",
    "files": [
        "dist"
    ],
    "scripts": {
        "generate": "node --import tsx scripts/generate.ts",
        "prebuild:tokens": "pnpm generate",
        "build": "pnpm exec turbo run build:artifact --filter=brutx-vue",
        "build:artifact": "tsup",
        "prepack": "pnpm build",
        "dev": "tsup --watch",
        "start": "node dist/index.js",
        "typecheck": "pnpm exec turbo run typecheck:source --filter=brutx-vue",
        "typecheck:source": "tsc --noEmit",
        "lint": "pnpm exec turbo run lint:source --filter=brutx-vue",
        "lint:source": "eslint src",
        "test": "vitest run --exclude \"tests/integration/**\" --exclude \"scripts/**\"",
        "test:integration": "vitest run tests/integration",
        "test:package": "node scripts/smoke-package.mjs",
        "test:consumers": "node scripts/test-consumers.mjs",
        "check:tokens": "tsx scripts/check-brutalist-tokens.ts"
    },
    "dependencies": {
        "@inquirer/prompts": "^8.5.2",
        "@vue/compiler-sfc": "^3.5.42",
        "chalk": "^5.3.0",
        "commander": "^15.0.0",
        "diff": "^8.0.4",
        "jiti": "^2.7.0",
        "jsonc-parser": "^3.3.1",
        "magic-string": "^0.30.21",
        "ora": "^9.4.0",
        "typescript": "^6.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/fs-extra": "^11.0.4",
        "@types/node": "^25.9.1",
        "@vitest/coverage-v8": "^4.1.11",
        "brutx-shared-vue": "workspace:*",
        "eslint": "^10.4.1",
        "fs-extra": "^11.3.5",
        "globals": "^17.6.0",
        "tsup": "^8.0.1",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.1",
        "vitest": "^4.1.11"
    },
    "keywords": [
        "brutx-vue",
        "cli",
        "neo-brutalism",
        "vue",
        "vue3",
        "components",
        "tailwindcss"
    ],
    "author": "lidaixingchen",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/lidaixingchen/brutxui-vue3"
    },
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=9.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "homepage": "https://lidaixingchen.github.io/brutxui-vue3/"
}
