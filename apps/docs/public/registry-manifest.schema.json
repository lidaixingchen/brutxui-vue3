{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://lidaixingchen.github.io/brutxui-vue3/registry-manifest.schema.json",
    "title": "BrutxUI Vue Registry Build Manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$schema",
        "name",
        "schemaVersion",
        "registryVersion",
        "buildTimestamp",
        "gitCommit",
        "itemCount",
        "items",
        "integrity"
    ],
    "properties": {
        "$schema": {
            "const": "https://lidaixingchen.github.io/brutxui-vue3/registry-manifest.schema.json"
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "schemaVersion": {
            "type": "integer",
            "minimum": 1
        },
        "registryVersion": {
            "type": "string",
            "minLength": 1
        },
        "buildTimestamp": {
            "type": [
                "string",
                "null"
            ],
            "format": "date-time"
        },
        "gitCommit": {
            "type": [
                "string",
                "null"
            ],
            "minLength": 1
        },
        "itemCount": {
            "type": "integer",
            "minimum": 0
        },
        "items": {
            "type": "object",
            "additionalProperties": {
                "$ref": "#/$defs/manifestItem"
            }
        },
        "integrity": {
            "description": "Manifest 自身完整性哈希：对 name/schemaVersion/registryVersion/items 规范化 JSON 求 sha256（hex，无前缀），排除 buildTimestamp/gitCommit/integrity/signature/keyId。CLI 拉取后复算比对并验签。",
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
        },
        "signature": {
            "description": "对 integrity 字段值的 Ed25519 签名（base64）。与 keyId 成对出现，两者皆存在时 CLI 才触发验签；缺省时向后兼容跳过。",
            "type": "string",
            "minLength": 1
        },
        "keyId": {
            "description": "标识签名所用密钥，CLI 持有的受信任公钥列表按 keyId 索引。",
            "type": "string",
            "minLength": 1
        }
    },
    "$defs": {
        "manifestItem": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "integrity",
                "fileCount",
                "dependencies",
                "registryDependencies"
            ],
            "properties": {
                "integrity": {
                    "type": "string",
                    "pattern": "^sha256-[a-f0-9]+$"
                },
                "fileCount": {
                    "type": "integer",
                    "minimum": 0
                },
                "dependencies": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "registryDependencies": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "category": {
                    "enum": [
                        "action",
                        "data-display",
                        "feedback",
                        "form",
                        "layout",
                        "marketing",
                        "media",
                        "navigation",
                        "overlay",
                        "page",
                        "utility",
                        "visual-effect"
                    ]
                },
                "examples": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uniqueItems": true
                },
                "status": {
                    "enum": [
                        "stable",
                        "legacy",
                        "deprecated"
                    ]
                },
                "replacement": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}
