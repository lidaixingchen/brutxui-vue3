{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "generate": {
            "cache": false,
            "outputs": [],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "scripts/**",
                "api-contract.ts",
                "package.json",
                "../../packages/shared/src/**"
            ]
        },
        "build:artifact": {
            "dependsOn": [
                "generate"
            ],
            "env": [
                "VERCEL"
            ],
            "outputs": [
                "dist/**"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "scripts/**",
                "api-contract.ts",
                "package.json",
                "tsconfig.json",
                "tsconfig.*.json",
                "vite.config.ts",
                "tsup.config.ts",
                "tailwind.config.*",
                "postcss.config.*",
                "../../packages/shared/src/**"
            ]
        },
        "brutx-registry-vue#build:artifact": {
            "cache": false,
            "dependsOn": [
                "brutx-ui-vue#generate"
            ],
            "env": [
                "BRUTX_REGISTRY_PRIVATE_KEY",
                "BRUTX_REGISTRY_KEY_ID"
            ],
            "outputs": [],
            "inputs": [
                "../../packages/ui/src/**",
                "../../packages/shared/src/**",
                "src/**",
                "scripts/**",
                "package.json"
            ]
        },
        "docs#build:artifact": {
            "dependsOn": [
                "brutx-ui-vue#build:artifact"
            ],
            "outputs": [
                ".vitepress/dist/**"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "**/*.md",
                ".vitepress/config.ts",
                ".vitepress/theme/**/*",
                "public/**/*",
                "package.json",
                "tsconfig.json"
            ]
        },
        "test": {
            "dependsOn": [
                "build:artifact"
            ],
            "inputs": [
                "src/**",
                "tests/**",
                "vitest.config.ts",
                "vitest.browser.config.ts",
                "vitest.ssr.config.ts",
                "registry/**",
                "../../packages/shared/src/**",
                "$TURBO_DEFAULT$",
                "scripts/**",
                "api-contract.ts",
                "../../packages/ui/api-contract.ts",
                "../../packages/ui/src/types/**"
            ]
        },
        "test:ssr": {
            "dependsOn": [
                "build:artifact"
            ],
            "inputs": [
                "src/**",
                "vitest.ssr.config.ts",
                "../../packages/shared/src/**",
                "$TURBO_DEFAULT$",
                "scripts/**",
                "api-contract.ts",
                "../../packages/ui/api-contract.ts",
                "../../packages/ui/src/types/**"
            ]
        },
        "typecheck:source": {
            "dependsOn": [
                "generate",
                "^typecheck:source"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "scripts/**",
                "api-contract.ts",
                "package.json",
                "tsconfig.json",
                "tsconfig.*.json",
                "../../packages/shared/src/**"
            ]
        },
        "docs#typecheck:source": {
            "dependsOn": [
                "brutx-ui-vue#build:artifact"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "**/*.md",
                ".vitepress/config.ts",
                ".vitepress/theme/**/*",
                "public/**/*",
                "package.json",
                "tsconfig.json",
                "../../packages/ui/src/**",
                "../../packages/shared/src/**"
            ]
        },
        "brutx-shared-vue#lint:source": {
            "dependsOn": [],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "tests/**",
                "package.json",
                "eslint.config.js",
                ".eslintrc.*"
            ]
        },
        "brutx-shared-vue#typecheck:source": {
            "dependsOn": [],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "package.json",
                "tsconfig.json",
                "tsconfig.*.json"
            ]
        },
        "brutx-registry-vue#lint:source": {
            "dependsOn": [
                "^lint:source"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "scripts/**",
                "tests/**",
                "package.json",
                "eslint.config.js",
                ".eslintrc.*",
                "../../packages/shared/src/**"
            ]
        },
        "brutx-registry-vue#typecheck:source": {
            "dependsOn": [
                "^typecheck:source"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "scripts/**",
                "package.json",
                "tsconfig.json",
                "tsconfig.*.json",
                "../../packages/shared/src/**"
            ]
        },
        "lint:source": {
            "dependsOn": [
                "generate",
                "^lint:source"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "src/**",
                "scripts/**",
                "tests/**",
                "api-contract.ts",
                "package.json",
                "eslint.config.js",
                ".eslintrc.*",
                "../../packages/shared/src/**"
            ]
        },
        "validate": {
            "dependsOn": [
                "build:artifact"
            ],
            "inputs": [
                "scripts/**",
                "registry/**",
                "../../packages/ui/registry-manifest.json",
                "../../packages/ui/src/components/**",
                "../../packages/ui/src/composables/**",
                "../../packages/ui/src/directives/**",
                "../../packages/ui/src/locales/**",
                "../../packages/ui/src/lib/**",
                "../../apps/docs/**/*.md",
                "../../packages/shared/src/**",
                "$TURBO_DEFAULT$",
                "api-contract.ts",
                "../../packages/ui/api-contract.ts",
                "../../packages/ui/src/types/**"
            ]
        },
        "bench": {
            "cache": false,
            "inputs": [
                "perf/**",
                "src/**"
            ]
        },
        "clean": {
            "cache": false
        }
    }
}
