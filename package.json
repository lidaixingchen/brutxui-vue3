{
    "name": "brutx-monorepo",
    "version": "1.0.0",
    "private": true,
    "description": "Neo-Brutalism UI Library Monorepo (Vue 3)",
    "scripts": {
        "dev": "pnpm --filter docs dev",
        "build": "turbo run build",
        "build:docs": "turbo run build --filter=docs",
        "lint": "turbo run lint",
        "clean": "turbo run clean",
        "typecheck": "turbo run typecheck",
        "test": "turbo run test",
        "test:ssr": "turbo run test:ssr",
        "test:consumers": "node packages/cli/scripts/test-consumers.mjs",
        "test:watch": "pnpm --filter brutx-ui-vue test:watch",
        "test:coverage": "pnpm --filter brutx-ui-vue test:coverage",
        "bench": "turbo run bench",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "test:release": "node scripts/release/tests/run-release-tests.mjs",
        "release": "pnpm release:check",
        "release:check": "node scripts/release/check.mjs",
        "release:prepare": "node scripts/release/prepare.mjs",
        "release:tag": "node scripts/release/prepare.mjs --tag",
        "changelog": "node scripts/release/generate-changelog.mjs",
        "changelog:dry": "node scripts/release/generate-changelog.mjs --dry-run",
        "check:contracts": "node scripts/check-contracts-all.mjs",
        "check:deps": "node scripts/scan-phantom-deps.mjs",
        "check:docs": "node scripts/docs/check-docs-all.mjs",
        "check:docs:fix": "node scripts/docs/check-docs-all.mjs --fix",
        "doc:archive": "node scripts/docs/archive-plan.mjs",
        "check:i18n": "node scripts/check-i18n.mjs --report",
        "check:i18n:strict": "node scripts/check-i18n.mjs",
        "commit:check": "node scripts/check-last-commit.mjs",
        "generate:tokens": "pnpm --filter brutx-ui-vue prebuild:tokens && pnpm --filter brutx-vue prebuild:tokens",
        "generate:component": "tsx scripts/generate.ts component",
        "generate:composable": "tsx scripts/generate.ts composable",
        "generate:page": "tsx scripts/generate.ts page",
        "prepare": "husky"
    },
    "engines": {
        "node": ">=22.5.0",
        "pnpm": ">=11.0.0"
    },
    "packageManager": "pnpm@11.21.0",
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@commitlint/cli": "^19.8.0",
        "husky": "^9.1.7",
        "tsx": "^4.22.4",
        "turbo": "^2.10.5"
    }
}
